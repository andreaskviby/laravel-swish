{
    "name": "andreaskviby/laravel-swish",
    "description": "Ett komplett Laravel-paket för att integrera Swish API - betalningar, återbetalningar, utbetalningar och QR-koder",
    "keywords": [
        "swish",
        "laravel",
        "payment",
        "sweden",
        "betalning",
        "api"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Andreas Kviby",
            "email": "andreas@example.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "guzzlehttp/guzzle": "^7.5",
        "illuminate/support": "^10.0|^11.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "orchestra/testbench": "^8.0|^9.0",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "AndreasKviby\\LaravelSwish\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AndreasKviby\\LaravelSwish\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AndreasKviby\\LaravelSwish\\SwishServiceProvider"
            ],
            "aliases": {
                "Swish": "AndreasKviby\\LaravelSwish\\Facades\\Swish"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
